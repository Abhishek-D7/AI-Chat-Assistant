# AI CHAT ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required API keys and credentials.

# App Settings
APP_TITLE=AI Chat Assistant

# API Keys & LLM Configuration



# OpenRouter API Key (Used by ChatOpenAI in langgraph_graph.py and main.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional / Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API Token (Used for BAAI/bge-large-en-v1.5 embeddings in persistence.py)
HF_TOKEN=your_huggingface_token_here

# Pinecone Vector DB (Used for conversation persistence & semantic search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=chat-assistant

# Google Calendar & OAuth Credentials



# Path to client_secret.json and token.json for Google Calendar booking integration
GOOGLE_CREDENTIALS=client_secret.json
GOOGLE_TOKEN=token.json

# Calendar / Booking Settings
WORKING_HOURS_START=9
WORKING_HOURS_END=18
MEETING_DURATION_MINUTES=60
BUFFER_TIME_MINUTES=15
DEFAULT_TIMEZONE=UTC

# AWS Configuration (Used for S3 document storage / PDF ingestion in routers/ingest.py)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-chat-assistant-bucket

# Cache Configuration
EMBEDDING_CACHE_SIZE=1000
STATS_CACHE_TTL=60
SYSTEM_MESSAGE_CACHE_SIZE=100

# Cleanup & TTL Configuration (in seconds)
STREAM_CLEANUP_INTERVAL=300
BUFFER_CLEANUP_INTERVAL=300
STREAM_TTL=300
BUFFER_TTL=300

# Celery / Redis Settings (Optional for async background workers in worker.py)
CELERY_BROKER=redis://localhost:6379/0
CELERY_BACKEND=redis://localhost:6379/0
